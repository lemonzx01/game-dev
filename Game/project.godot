; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes before the first key/value pair.

config_version=5

[application]

config/name="Fantasy World Simulator"
run/main_scene="res://Presentation/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[dotnet]

project/assembly_name="Game"

[rendering]
renderer/rendering_method="gl_compatibility"
